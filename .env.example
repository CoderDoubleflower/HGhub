# 网页访问账号。密码必须至少 12 位；不要使用这里未填写的默认值。
HGHUB_ADMIN_USERNAME=admin
HGHUB_ADMIN_PASSWORD=

# 手机访问 http://服务器局域网IP:3000
HGHUB_BIND=0.0.0.0
HGHUB_PORT=3000

# 可在网页「我的 → 网络与代理」中修改，网页保存的值优先。
# HTTP / HTTPS / SOCKS5 / SOCKS5H；留空为直连。
# 宿主机代理示例：http://host.docker.internal:7890
HGHUB_PROXY=

# 使用 HTTPS 反向代理时填写外部地址（不带路径），并开启 Secure Cookie。
HGHUB_PUBLIC_ORIGIN=
HGHUB_COOKIE_SECURE=false

# 可选：更新上游站点；媒体白名单额外域名以逗号分隔，支持 *.example.com。
# HGHUB_UPSTREAM_BASE=https://huangguoai.com
# HGHUB_MEDIA_HOSTS=cdn.example.com,*.example.net
