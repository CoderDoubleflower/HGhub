# 直接运行 Node 服务时也启用免网页登录；默认 Compose 已显式启用。
HGHUB_AUTH_DISABLED=true

# 手机访问 http://服务器局域网IP:3000
HGHUB_HOST=0.0.0.0
HGHUB_PORT=3000

# 可在网页「我的 → 网络与代理」中修改，网页保存的值优先。
# HTTP / HTTPS / SOCKS5 / SOCKS5H；留空为直连。
# host 网络下宿主机代理示例：http://127.0.0.1:7890
HGHUB_PROXY=

# 使用 HTTPS 反向代理时填写外部地址（不带路径），并开启 Secure Cookie。
HGHUB_PUBLIC_ORIGIN=
HGHUB_COOKIE_SECURE=false

# Docker Hub 加速源返回 401 / 403 时，可改用 Docker 官方在 ECR Public 的镜像。
# 这两项只控制构建和目录初始化镜像，不是应用运行时代理。
# HGHUB_NODE_IMAGE=public.ecr.aws/docker/library/node:24-alpine
# HGHUB_INIT_IMAGE=public.ecr.aws/docker/library/alpine:3.22

# 只有需要额外网页登录时，直接运行 Node 服务或自行修改 Compose：
# HGHUB_AUTH_DISABLED=false
# HGHUB_ADMIN_USERNAME=admin
# HGHUB_ADMIN_PASSWORD=自行设置12到256个字符的密码

# 可选：更新上游站点；媒体白名单额外域名以逗号分隔，支持 *.example.com。
# HGHUB_UPSTREAM_BASE=https://huangguoai.com
# HGHUB_MEDIA_HOSTS=cdn.example.com,*.example.net
